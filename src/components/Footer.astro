---
import { SITE, SOCIALS } from "../consts";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <ul class="site-footer__socials" aria-label="Social links">
      {
        SOCIALS.map((s) => (
          <li>
            <a
              href={s.href}
              rel="me noopener noreferrer"
              target="_blank"
              aria-label={s.name}
              title={s.name}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path fill="currentColor" d={s.icon} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="site-footer__meta">
      <span class="comment">
        built with <a href="https://astro.build">Astro</a>, hosted on GitHub
        Pages &middot; <a href={SITE.repo}>source</a>
      </span>
    </p>
    <p class="site-footer__copy">
      <span aria-hidden="true" class="prompt__user">{SITE.user}@{SITE.domain}</span>
      <span class="comment">&copy; {year} {SITE.name}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    flex-shrink: 0;
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
    padding-block: var(--sp-8);
  }
  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .site-footer__socials {
    display: flex;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-2);
    padding: 0;
    list-style: none;
  }
  .site-footer__socials a {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .site-footer__socials a:hover {
    color: var(--text-strong);
    border-color: var(--text-muted);
  }
  .site-footer__meta,
  .site-footer__copy {
    margin: 0;
    font-size: 0.85rem;
  }
  .site-footer__copy {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    align-items: baseline;
  }
</style>
